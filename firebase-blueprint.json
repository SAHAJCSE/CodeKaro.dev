{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, account status, and aggregated practice statistics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID.", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "description": "Unique handle.", "minLength": 1, "maxLength": 60 },
        "displayName": { "type": "string", "description": "Full display name.", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "description": "Avatar image URL.", "maxLength": 500 },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "Primary role of user." },
        "adminRole": { "type": "string", "enum": ["super_admin", "content_admin", "moderator", "support_admin"], "description": "Specific admin role if role is admin." },
        "status": { "type": "string", "enum": ["active", "suspended"], "description": "Account status." },
        "provider": { "type": "string", "enum": ["google", "github", "email"], "description": "Auth provider." },
        "otpVerified": { "type": "boolean", "description": "Whether verified." },
        "stats": {
          "type": "object",
          "description": "Aggregated user coding stats.",
          "properties": {
            "totalSolved": { "type": "number" },
            "easySolved": { "type": "number" },
            "mediumSolved": { "type": "number" },
            "hardSolved": { "type": "number" },
            "totalSubmissions": { "type": "number" },
            "acceptedSubmissions": { "type": "number" },
            "acceptanceRate": { "type": "number" },
            "currentStreak": { "type": "number" },
            "longestStreak": { "type": "number" },
            "lastActiveDate": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "role", "status", "provider", "createdAt", "updatedAt"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Per-problem progress for a specific user.",
      "type": "object",
      "properties": {
        "problemId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["solved", "attempted"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "topics": { "type": "array", "items": { "type": "string" } },
        "attemptsCount": { "type": "number" },
        "bestRuntimeMs": { "type": "number" },
        "firstSolvedAt": { "type": "string", "format": "date-time" },
        "lastSubmittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["problemId", "userId", "status", "attemptsCount", "lastSubmittedAt", "updatedAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Bookmarked problems for quick reference.",
      "type": "object",
      "properties": {
        "problemId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["problemId", "userId", "createdAt"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "Daily activity log for streak and contribution heatmap calculation.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "submissionCount": { "type": "number" },
        "acceptedCount": { "type": "number" },
        "problemsSolved": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "userId", "submissionCount", "acceptedCount", "updatedAt"]
    },
    "Problem": {
      "title": "Problem",
      "description": "Java OOP practice challenge with test cases.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "display_number": { "type": "number" },
        "display_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "readme": { "type": "string" },
        "starter": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "topics": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "path_id": { "type": "string" },
        "path_name": { "type": "string" },
        "order_in_path": { "type": "number" },
        "collection_ids": { "type": "array", "items": { "type": "string" } },
        "sample_cases": { "type": "array" },
        "hints": { "type": "array", "items": { "type": "string" } },
        "published": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "totalSubmissions": { "type": "number" },
        "acceptedSubmissions": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "difficulty", "topics", "starter", "published", "isArchived", "createdAt", "updatedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Code submission evaluation record with verdict and test breakdown.",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "problemId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "problemTitle": { "type": "string" },
        "language": { "type": "string", "enum": ["java", "Java"] },
        "sourceCode": { "type": "string", "maxLength": 65536 },
        "status": { "type": "string", "enum": ["PENDING", "RUNNING", "COMPLETED"] },
        "verdict": { "type": "string", "enum": ["ACCEPTED", "WRONG_ANSWER", "COMPILATION_ERROR", "RUNTIME_ERROR", "TIME_LIMIT_EXCEEDED", "MEMORY_LIMIT_EXCEEDED", "INTERNAL_ERROR"] },
        "passedTests": { "type": "number" },
        "totalTests": { "type": "number" },
        "runtimeMs": { "type": "number" },
        "memoryKb": { "type": "number" },
        "output": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "evaluatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["submissionId", "userId", "problemId", "language", "sourceCode", "status", "submittedAt"]
    },
    "LearningPath": {
      "title": "LearningPath",
      "description": "Curated Java topic learning track.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "problemIds": { "type": "array", "items": { "type": "string" } },
        "icon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "problemIds"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Group of problems for study or interview preparation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "problemIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "problemIds"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "System-wide announcement banner or notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "normal", "high"] },
        "isPublished": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "priority", "isPublished", "publishedAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Issue or test case discrepancy filed by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "problemId": { "type": "string" },
        "type": { "type": "string", "enum": ["bug", "test_case_error", "problem_description", "other"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_review", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "problemId", "type", "message", "status", "createdAt"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Administrative authority record with custom role and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "content_admin", "moderator", "support_admin"] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "isSuspended": { "type": "boolean" },
        "assignedBy": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "permissions", "isSuspended", "assignedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security record of administrative action.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminUid", "action", "targetType", "targetId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Primary user profile with student/admin roles and aggregated stats."
    },
    "/users/{userId}/progress/{problemId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "User problem progress status, attempts, and best runtime."
    },
    "/users/{userId}/bookmarks/{problemId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Bookmarked problems for quick revision."
    },
    "/users/{userId}/activity/{date}": {
      "schema": { "$ref": "#/entities/UserActivity" },
      "description": "Daily activity log used for streak and 2D/3D skyline visualizers."
    },
    "/problems/{problemId}": {
      "schema": { "$ref": "#/entities/Problem" },
      "description": "Published Java OOP coding challenges."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Official persistent code execution submissions."
    },
    "/learningPaths/{pathId}": {
      "schema": { "$ref": "#/entities/LearningPath" },
      "description": "Structured curriculum tracks."
    },
    "/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/Collection" },
      "description": "Curated practice problem collections."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Platform updates and maintenance notices."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Student bug and test-case reports."
    },
    "/adminProfiles/{uid}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Privileged admin profiles and granular permissions."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security log of administrative changes."
    }
  }
}
