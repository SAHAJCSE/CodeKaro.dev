{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=$1"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/app.css",
      "destination": "/web/app.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
