        "input": "new Box(3, 4, 5)",
        "expected": "3 4 5 60"
      },
      {
        "name": "copy constructor (sample)",
        "input": "new Box(new Box(3, 4, 5))",
        "expected": "3 4 5 60"
      }
    ]
